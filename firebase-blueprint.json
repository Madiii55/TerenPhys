{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile stored in Firestore",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "bio": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "provider": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "email", "bio", "provider", "createdAt"]
    },
    "PostAuthor": {
      "title": "PostAuthor",
      "description": "Person permitted to publish posts for selected grades",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "name": { "type": "string" },
        "grades": {
          "type": "array",
          "items": { "type": "number" }
        },
        "isActive": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      },
      "required": ["email", "grades", "isActive"]
    },
    "ClassPost": {
      "title": "ClassPost",
      "description": "A post published to the feed for one school grade",
      "type": "object",
      "properties": {
        "grade": { "type": "number" },
        "text": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorAvatarUrl": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["grade", "text", "authorId", "authorName", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Stores user profiles and settings; passwords are managed by Firebase Authentication"
    },
    "/postAuthors/{authorId}": {
      "schema": "PostAuthor",
      "description": "Stores publication access for a Firebase Authentication UID"
    },
    "/posts/{postId}": {
      "schema": "ClassPost",
      "description": "Stores posts for the 7th, 8th, and 9th grade feeds"
    }
  }
}
